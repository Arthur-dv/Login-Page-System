{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "typeRoots": ["../frontend/node_modules/@types"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
